# Copy this file to `.env` and fill in real values.
# `.env` is gitignored so your secrets never reach the public repo.

# Where the SQLite database file lives (created on first run).
DATABASE_PATH=./data/chores.db

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ORIGIN is NOT required: the app does its own same-host CSRF check so it can
# be reached as http://localhost, http://<LAN-IP>, and http://<hostname> at the
# same time. Only set this if you put the app behind an HTTPS reverse proxy.
# ORIGIN=https://chores.example.com

# Port the server listens on.
PORT=3000
