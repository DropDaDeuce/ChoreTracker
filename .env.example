# Copy this file to `.env` and fill in real values.
# `.env` is gitignored so your secrets never reach the public repo.

# Where the SQLite database file lives (created on first run).
DATABASE_PATH=./data/chores.db

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin the app is served from (needed by SvelteKit for form actions/CSRF).
# Use your home server's hostname or LAN IP.
ORIGIN=http://home-server.local:3000

# Port the server listens on.
PORT=3000
